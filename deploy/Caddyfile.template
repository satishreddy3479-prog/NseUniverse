# Public HTTPS front door. Everything requires a login: the app has no user accounts of its own,
# and its control endpoints trust the proxy (which only forwards authenticated requests).
# The one exception is the app's install files (web manifest, service worker, icons): a browser fetches them without
# the login, and without them the phone says "This app cannot be installed". They hold no data.
__DOMAIN__ {
	encode zstd gzip

	@private not path /manifest.webmanifest /sw.js /icon-192.png /icon-512.png /icon-maskable-512.png /apple-touch-icon.png /logo.svg /logo-maskable.svg
	basic_auth @private {
		import /etc/nse-universe/caddy-users
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		-Server
	}

	handle /api/* {
		reverse_proxy 127.0.0.1:8010
	}
	handle /ws/* {
		reverse_proxy 127.0.0.1:8010
	}
	# Built files carry a content hash in their name, so a browser may keep them for good. A name that does not exist is a plain
	# 404 (never the index page: a page that asked for a file from an older build must fail clearly, not receive HTML as script).
	handle /assets/* {
		root * /opt/nse-universe/current/frontend/dist
		@present file
		header @present Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	handle {
		root * /opt/nse-universe/current/frontend/dist
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}

	log {
		output file /var/log/caddy/nse-universe.log {
			roll_size 5MiB
			roll_keep 3
		}
	}
}
