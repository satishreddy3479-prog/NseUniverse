[Unit]
Description=NSE Universe backend (read-only Kotak Neo market data, analytics, prediction)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=nseuniverse
Group=nseuniverse
WorkingDirectory=/opt/nse-universe/current/backend
EnvironmentFile=/etc/nse-universe/backend.env
Environment=HOME=/var/lib/nse-universe/home
Environment=DATA_DIR=/var/lib/nse-universe/data
Environment=LOG_DIR=/var/log/nse-universe
Environment=APP_HOST=127.0.0.1
Environment=APP_PORT=8010
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/nse-universe/venv/bin/python -m app
Restart=on-failure
RestartSec=10
TimeoutStopSec=20
# 1 GB machine: leave room for the OS, Caddy and anything else on the server
MemoryHigh=650M
MemoryMax=850M
Nice=5
# least privilege
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/nse-universe /var/log/nse-universe
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes

[Install]
WantedBy=multi-user.target
