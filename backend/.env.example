# Copy to backend/.env and fill in on YOUR machine only. Never commit .env.
# NSE Universe uses only real Kotak Neo data (there is no demo or mock mode).
# --- Kotak Neo (all five values are required; the backend will not start without them) ---
# Consumer key / access token from Neo app -> Trade API card -> API dashboard
KOTAK_CONSUMER_KEY=
# Registered mobile number with country code, e.g. +91XXXXXXXXXX
KOTAK_MOBILE_NUMBER=
# Unique Client Code (Neo app -> Profile)
KOTAK_UCC=
# Trading MPIN
KOTAK_MPIN=
# Base32 TOTP secret shown during Kotak TOTP registration (used to generate 6-digit codes)
KOTAK_TOTP_SECRET=

# --- Application ---
APP_HOST=127.0.0.1
APP_PORT=8000
# Comma-separated browser origins allowed to call the API (Vite dev server by default)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Where snapshots/sessions are stored (git-ignored). Relative paths are relative to backend/
DATA_DIR=../data
LOG_DIR=../logs
LOG_LEVEL=INFO
UNDERLYING=NIFTY
# Strikes per side requested from option_chain(); must be a multiple of 10
OPTION_CHAIN_STRIKE_COUNT=40
# A snapshot older than this (seconds) is shown as stale
SNAPSHOT_STALE_AFTER_SECONDS=300
# --- Live stream (Kotak SFeed) ---
# Start streaming automatically when the backend starts (true: snapshot first, then the live stream)
STREAM_AUTOSTART=true
# No market data for this long while "streaming" => shown as stale
STREAM_STALE_AFTER_SECONDS=30
STREAM_BROADCAST_INTERVAL_MS=250
STREAM_MAX_RECONNECT_ATTEMPTS=8

# Scheduled snapshots during market hours (09:15-15:30 IST, Mon-Fri); fills the Analysis time series.
# Each sample is two read-only option-chain calls (weekly + monthly). Stored gzip-compressed: about
# 35 KB per sample (measured on real payloads), roughly 13 MB/day at 60 s. Unchanged chains are skipped.
SAMPLER_ENABLED=true
SAMPLER_INTERVAL_SECONDS=60
# Sampling pauses when free disk space falls below this many GB
SAMPLER_MIN_FREE_GB=2

# Prediction Intelligence: download daily price history (Yahoo via yfinance, unofficial, personal use)
# by itself on first start and once a day after 18:30 IST on trading days
HISTORY_AUTOFETCH=true
HISTORY_START=2007-01-01

# Prediction Intelligence: NSE participant-wise F&O files + FII/DII cash (public NSE files, one request at a time)
FLOWS_AUTOFETCH=true
FLOWS_HISTORY_DAYS=10
